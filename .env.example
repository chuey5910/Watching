# ---------- พื้นฐาน ----------
# scripts/install.sh จะสุ่มค่านี้ให้อัตโนมัติตอนสร้าง .env ครั้งแรก
SECRET_KEY=change-me
# ค่าเริ่มต้นเป็น SQLite ที่ data/jabta.sqlite3 — เปลี่ยนเป็น PostgreSQL ได้
# DATABASE_URL=postgresql://user:pass@localhost/jabta
SESSION_HOURS=72
# เปิดเป็น 1 เมื่อเข้าผ่าน https ของ tailscale serve
SESSION_COOKIE_SECURE=0

# ---------- Tailscale ----------
TAILSCALE_ONLY=1
TRUST_TAILSCALE_HEADERS=1
# CIDR ที่เชื่อถือเพิ่มเติม คั่นด้วย , เช่น 192.168.1.0/24
EXTRA_TRUSTED_CIDRS=

# ---------- การสมัคร/อนุมัติ ----------
REGISTRATION_OPEN=1
FIRST_USER_IS_ADMIN=1
MAX_LOGIN_FAILS=8
LOCKOUT_MINUTES=15

# ---------- ดึงข่าว ----------
FETCH_INTERVAL_MINUTES=10
FETCH_TIMEOUT=20
FETCH_WORKERS=8
ARTICLE_RETENTION_DAYS=45
# 1 = เก็บเฉพาะข่าวที่เข้าหมวดที่สนใจ
KEEP_ONLY_MATCHED=1
# ใส่ base URL ถ้าติดตั้ง RSSHub / RSS-Bridge เองสำหรับ Facebook/X/TikTok
RSSHUB_BASE=
RSSBRIDGE_BASE=

# ---------- LINE ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
MORNING_BRIEF_TIME=06:30

# ---------- Log ----------
LOG_LEVEL=INFO
TZ=Asia/Bangkok
